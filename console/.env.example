# Copy to .env. The server loads it automatically; shell env wins.
# Generate a token with: openssl rand -hex 32

# HTTP/WS server
PORT=3000
HOST=127.0.0.1

# If set, /api/state, control endpoints, and Socket.IO require this token.
# Leave empty only if the tunnel URL is private.
ADMIN_TOKEN=

# GitHub release used as the turtle rendezvous point.
GITHUB_REPO=Igidn/cc-util
RELEASE_TAG=tunnel-latest
PUBLISH=1

# Set to skip opentunnel and use an existing public URL.
PUBLIC_URL=

# Mine geometry, world coordinates. The station anchor is BASE_Y.
SECTOR_HALF=48
TOP_WORLD_Y=0
BOTTOM_WORLD_Y=-58
LAYER_STEP=2
BRANCH_SPACING=3

# Safety / trip budget (the turtle clamps these with its own hard caps)
RESERVE=64
MAX_TRIP_BLOCKS=240
MAX_VEIN_BLOCKS=24
MAX_RADIUS=128
MAX_DEPTH=200

# Miners per station. The sector is split into this many X lanes so miners at
# the same station never mine the same blocks.
MINER_LANES=2

# Station layout. One station every STATION_SPACING blocks along X.
BASE_X=0
BASE_Y=10
BASE_Z=0
STATION_SPACING=256
