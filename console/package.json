{
  "name": "cc-util-console",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/index.ts",
    "dev:web": "npm run dev -w web",
    "start": "tsx src/index.ts",
    "build": "npm run build -w web && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck -w web",
    "test": "tsx test/*.test.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "demo:turtles": "tsx scripts/demo-turtles.ts",
    "publish:runtime": "tsx scripts/publish-runtime.ts"
  },
  "dependencies": {
    "socket.io": "^4.8.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^10.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
